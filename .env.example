# Public site URL, used for canonical links, Open Graph tags and the sitemap.
NEXT_PUBLIC_SITE_URL=https://www.regalfit.com

# Admin portal (/admin)
# The password the client types to log in.
ADMIN_PASSWORD=
# A long random string (32+ characters) used to sign login cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_SESSION_SECRET=

# Vercel Blob read-write token (stores admin-uploaded photos and content).
# Added automatically when a Blob store is connected to the Vercel project; pull it with `vercel env pull`.
BLOB_READ_WRITE_TOKEN=

# Optional: your Cloudinary cloud name. Lets /data use bare Cloudinary public IDs
# (e.g. "regalfit/look-01") instead of full URLs.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
